{
  "name": "touchline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Touchline — a discreet, live 2D football matchday console",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"node server/index.mjs\" \"vite --host 127.0.0.1\"",
    "dev:api": "node server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run plugin:build",
    "debug:build": "npm run typecheck && npm run replay:build && vite build",
    "debug:serve": "node server/index.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "plugin:build": "node plugin/build.mjs",
    "plugin:pack": "npm run typecheck && npm test && npm run plugin:build && npm pack ./plugin --pack-destination dist",
    "test": "node --test tests/*.test.mjs",
    "replay:build": "node scripts/build-replay.mjs",
    "replay:demo": "node scripts/make-demo-replay.mjs",
    "data:fetch": "node scripts/fetch-open-data.mjs",
    "check:visual": "node scripts/visual-check.mjs",
    "check:plugin": "node scripts/check-plugin.mjs",
    "check:replay": "node scripts/check-replay.mjs",
    "check:live": "node scripts/check-live.mjs",
    "release:prepare": "npm run plugin:pack && node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "esbuild": "0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KhalilWong/dsh-plugin-touchline-football.git"
  },
  "homepage": "https://github.com/KhalilWong/dsh-plugin-touchline-football",
  "bugs": {
    "url": "https://github.com/KhalilWong/dsh-plugin-touchline-football/issues"
  }
}
