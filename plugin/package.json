{
  "name": "dsh-plugin-touchline",
  "version": "0.8.3",
  "type": "module",
  "description": "Touchline Football: floating football scores, event-based pitch visualization and local tracking replay for DSH. No bundled match data.",
  "license": "MIT",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KhalilWong/dsh-plugin-touchline-football.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/KhalilWong/dsh-plugin-touchline-football",
  "bugs": {
    "url": "https://github.com/KhalilWong/dsh-plugin-touchline-football/issues"
  }
}
